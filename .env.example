# Supabase — значения из Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: schedule/squad import and auth provisioning
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Mini App (server-only — never expose to browser)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Public URL of the deployed app (for Telegram web_app buttons in admin pings)
MINI_APP_URL=https://your-app.vercel.app
# Random secret: openssl rand -hex 32
TELEGRAM_AUTH_PEPPER=your-random-pepper-here

# Server-only: AES-256-GCM key for encrypted prediction outcomes
# Generate: openssl rand -base64 32
PREDICTIONS_ENCRYPTION_KEY=your-base64-encryption-key-here

# Dev only: auto sign-in as this Telegram user when opened outside Telegram
# Use your telegram_id from profiles table
DEV_TELEGRAM_ID=your-telegram-id

# One-time migration: copy player photos from another Supabase project
# SOURCE_SUPABASE_URL=https://<source-project-ref>.supabase.co
# SOURCE_SUPABASE_SERVICE_ROLE_KEY=your-source-service-role-key

# Onside AI analytics (server-only, optional overrides)
# ONSIDE_API_BASE=https://onsidearena.com/api/v1
# ONSIDE_USER_AGENT=predictorwc2026bot/1.0

# Edge function send-prediction-reminders (set via supabase secrets set, not Vercel)
# MINI_APP_URL=https://your-app.vercel.app
